NEXT_PUBLIC_APP_URL=https://app.edpilot.ai
NEXT_PUBLIC_MARKETING_URL=https://edpilot.ai
CONTACT_FORM_WEBHOOK_URL=
# Server-only shared bearer secret for contact-intake. Never prefix this with
# NEXT_PUBLIC_ or expose it to browser code.
CONTACT_FORM_WEBHOOK_SECRET=

# Postgres connection string for newsletter subscriber storage.
# Provisioned automatically by the Neon integration on the Vercel Marketplace
# (Vercel project -> Storage -> Neon). The integration sets DATABASE_URL for you;
# POSTGRES_URL is also accepted as a fallback.
DATABASE_URL=
